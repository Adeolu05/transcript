# Copy to .env and fill in values:  cp .env.example .env
# Works for local dev, Docker Compose, Render/Railway, or Vercel frontend + API elsewhere.

# --- Web ↔ API (CORS)
# Primary origin (Next.js dev server or production site).
FRONTEND_URL=http://localhost:3000
# Optional: more origins, comma-separated (no spaces). Examples:
#   Apex + www:     https://example.com,https://www.example.com
#   Preview URL:    https://your-app.vercel.app
# Note: for local FRONTEND_URL, the API also auto-allows the localhost↔127.0.0.1 twin.
# CORS_EXTRA_ORIGINS=

# --- Reverse proxy / load balancer
# 0 = app reached directly (typical local). 1 = one trusted proxy (Nginx, Caddy, Render, etc.).
TRUSTED_PROXY_COUNT=0

# --- API behaviour
DEBUG=false
# Extract quota (scarce: upstream YouTube/Vimeo)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=86400
# Separate buckets so downloads/analytics do not burn extract quota
RATE_LIMIT_CONVERT_REQUESTS=40
RATE_LIMIT_EVENTS_REQUESTS=2000
RATE_LIMIT_DOWNLOAD_ENABLED=false
RATE_LIMIT_DOWNLOAD_REQUESTS=200
MAX_VIDEO_DURATION_SECONDS=10800
TRANSCRIPT_TIMEOUT_SECONDS=15
FILE_TTL_HOURS=1
CONVERT_MAX_CONCURRENCY=2
MAX_RAW_TEXT_LENGTH=500000
MAX_TRANSCRIPT_SEGMENTS=20000

# Generated files (empty = <project>/data/tmp). Docker/Render: /app/data/tmp
# FILE_STORAGE_DIR=
IN_PROCESS_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=900

# --- Shared state (recommended in production)
# Redis shares rate-limit counts across Gunicorn workers + the Telegram bot and keeps
# bot preferences across restarts. Unset/unreachable = per-process in-memory fallback.
# REDIS_URL=redis://localhost:6379/0
# TELEGRAM_PREFS_TTL_DAYS=90
# Key for hashing IPs / Telegram IDs in logs (any long random string). Unset = random per process.
# LOG_HASH_SECRET=

# --- Internal metrics dashboard (Basic Auth at /internal/metrics)
METRICS_USERNAME=admin
# Change this before any public deployment.
METRICS_PASSWORD=changeme

# --- Telegram bot (optional; use: docker compose --profile bot up -d)
TELEGRAM_BOT_TOKEN=YOUR_TOKEN_HERE

# --- Docker Compose host port (see docker-compose.yml)
# API_PORT=8000

# --- Sentry (leave empty to disable)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- YouTube captions (REQUIRED on cloud / VPS: YouTube bans datacenter IPs)
# Without this, every link fails with "YouTube blocked this server", even English videos.
# YOUTUBE_TRANSCRIPT_LANGUAGE_PRIORITY=en,de
# YOUTUBE_HTTP_PROXY_URL=
# YOUTUBE_HTTPS_PROXY_URL=
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# WEBSHARE_PROXY_LOCATIONS=

# --- Transcript disk cache
TRANSCRIPT_CACHE_ENABLED=true
TRANSCRIPT_CACHE_TTL_HOURS=72
# TRANSCRIPT_CACHE_DIR=

# --- Next.js (web/) — set in Vercel + web/.env.local for browser calls to the API
# Production: HTTPS URL of the deployed API, no trailing slash (see BACKEND_DEPLOYMENT_HANDOFF.md).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
